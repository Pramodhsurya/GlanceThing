{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "client/src/components/Widgets/Screen.tsx",
    "client/src/components/Widgets/screenModel.ts",
    "client/src/components/Widgets/widgets/BaseWidget/BaseWidget.tsx"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"]
    }
  }
}
